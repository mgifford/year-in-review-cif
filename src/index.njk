    </div>

    <div class="tool" data-tool>
      <button type="button" class="tool-btn" id="chaptersBtn" aria-expanded="false" aria-controls="chaptersPanel">
        <svg class="tool-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
