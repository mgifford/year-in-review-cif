          <circle cx="12" cy="5.9" r="1.7"/>
          <path d="M5.6 9.1a.95.95 0 0 1 .5-1.2c1.9-.75 3.9-1.1 5.9-1.1s4 .35 5.9 1.1a.95.95 0 1 1-.7 1.77c-1.1-.44-2.2-.72-3.35-.86v2.6c0 .5.08 1 .25 1.47l2.2 6.06a.95.95 0 1 1-1.79.65L12.4 15h-.8l-2.11 4.6a.95.95 0 1 1-1.79-.66l2.2-6.05c.17-.47.25-.97.25-1.47v-2.6c-1.15.14-2.28.42-3.35.86a.95.95 0 0 1-1.2-.58Z"/>
        </svg>
        <span>Display</span>
        <svg class="tool-chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M0 0h10L5 6z"/></svg>
      </button>
      <div class="tool-panel" id="displayPanel" hidden>
        <h2>Display settings</h2>
