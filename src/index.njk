<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>A Year of Growth — Year in Review</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --sky:#E8F0E4;
    --sky-deep:#D5E4DB;
    --pine:#1E4633;
    --pine-light:#3A6B4E;
    --leaf:#5D8F5F;
    --leaf-young:#8FB878;
    --bark:#6B4A32;
    --sun:#E8B34B;
    --blossom:#E58FA2;
    --ink:#1B2A22;
    --ink-soft:#4A5A50;
    --card:rgba(255,255,255,0.82);
    --display:'Fraunces', Georgia, 'Times New Roman', serif;
    --body:'Outfit', -apple-system, 'Segoe UI', sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:auto}
  html[data-motion="full"]{scroll-behavior:smooth}
  body{
    font-family:var(--body);
    color:var(--ink);
    background:var(--sky);
    overflow-x:hidden;
    line-height:1.6;
  }
  ::selection{background:var(--sun);color:var(--ink)}

  /* ---------- Hero ---------- */
  .hero{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:2rem 1.5rem;
    position:relative;
  }
  .hero .eyebrow{
    font-size:.85rem;
    letter-spacing:.28em;
    text-transform:uppercase;
    color:var(--pine-light);
    font-weight:600;
    margin-bottom:1.2rem;
  }
  .hero h1{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(2.8rem, 8vw, 6rem);
    line-height:1.02;
    color:var(--pine);
    max-width:14ch;
  }
  .hero h1 em{
    font-style:italic;
    color:var(--bark);
  }
  .hero p{
    margin-top:1.4rem;
    max-width:44ch;
    color:var(--ink-soft);
    font-size:1.05rem;
  }
  .seed{
    margin-top:2.4rem;
    width:64px;height:64px;
  }
  /* Finite, self-stopping (< 5s) idle motion; only when full motion is on. */
  html[data-motion="full"] .seed{
    animation:bob 2.4s ease-in-out 2;
  }
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  .scroll-hint{
    position:absolute;
    bottom:2rem;
    font-size:.8rem;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--ink-soft);
  }
  .scroll-hint::after{
    content:'';
    display:block;
    width:1px;height:34px;
    background:var(--ink-soft);
    margin:.6rem auto 0;
    transform-origin:top;
  }
  html[data-motion="full"] .scroll-hint::after{
    animation:drip 1.6s ease-in-out 3;
  }
  @keyframes drip{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(0)}}

  /* ---------- Growth track ----------
     Base (no-JS / reduced motion): normal document flow, static tree.
     Full motion only: tall scroll runway + sticky stage. */
  .growth-track{
    position:relative;
    background:linear-gradient(to top, var(--sky-deep) 0%, var(--sky) 55%, #F2F6EC 100%);
  }
  html[data-motion="full"] .growth-track{
    /* tall runway: the tree grows across this whole distance */
    height:520vh;
    background:none;
  }
  .tree-stage{
    position:relative;
    width:100%;
    overflow:hidden;
  }
  html[data-motion="full"] .tree-stage{
    position:sticky;
    top:0;
    height:100vh;
    background:linear-gradient(to top, var(--sky-deep) 0%, var(--sky) 55%, #F2F6EC 100%);
  }
  .tree-stage svg{
    display:block;
    width:100%;
    height:auto;
    max-height:70vh;
    margin:0 auto;
  }
  html[data-motion="full"] .tree-stage svg{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    max-height:none;
  }
  .stage-caption{
    position:absolute;
    top:1.4rem;
    left:50%;
    transform:translateX(-50%);
    font-size:.78rem;
    letter-spacing:.26em;
    text-transform:uppercase;
    color:var(--pine-light);
    font-weight:600;
    background:var(--card);
    padding:.45rem 1.1rem;
    border-radius:99px;
    backdrop-filter:blur(6px);
    white-space:nowrap;
  }

  /* Chapters: normal flow by default; overlay the sticky stage only in full motion. */
  .chapters{
    position:relative;
    max-width:960px;
    margin:0 auto;
    padding:2rem 1.5rem 3rem;
    display:grid;
    gap:1.5rem;
  }
  html[data-motion="full"] .chapters{
    position:absolute;
    inset:0;
    max-width:none;
    margin:0;
    padding:0;
    display:block;
    pointer-events:none;
  }
  .chapter{display:block}
  html[data-motion="full"] .chapter{
    height:130vh;
    display:flex;
    align-items:center;
    padding:0 6vw;
  }
  html[data-motion="full"] .chapter:first-child{height:110vh}
  html[data-motion="full"] .chapter.right{justify-content:flex-end}
  .panel{
    pointer-events:auto;
    max-width:380px;
    background:var(--card);
    backdrop-filter:blur(10px);
    border:1px solid rgba(30,70,51,.14);
    border-radius:18px;
    padding:1.8rem 1.9rem;
    box-shadow:0 18px 44px -18px rgba(27,42,34,.25);
  }
  /* Full motion: panels start hidden and animate in on scroll. */
  html[data-motion="full"] .panel{
    opacity:0;
    transform:translateY(36px);
    transition:opacity .7s ease, transform .7s cubic-bezier(.22,.9,.3,1);
  }
  html[data-motion="full"] .panel.in{opacity:1;transform:translateY(0)}
  .panel .tag{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    font-size:.72rem;
    letter-spacing:.22em;
    text-transform:uppercase;
    font-weight:600;
    color:var(--pine-light);
    margin-bottom:.7rem;
  }
  .panel h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.9rem;
    color:var(--pine);
    line-height:1.1;
    margin-bottom:.6rem;
  }
  .panel p{font-size:.95rem;color:var(--ink-soft)}
  .panel .stat-row{
    display:flex;
    gap:1.6rem;
    margin-top:1.2rem;
    padding-top:1.1rem;
    border-top:1px dashed rgba(30,70,51,.25);
  }
  .panel .stat b{
    display:block;
    font-family:var(--display);
    font-size:1.7rem;
    font-weight:700;
    color:var(--ink);
    line-height:1;
  }
  .panel .stat span{
    font-size:.78rem;
    letter-spacing:.05em;
    color:var(--ink-soft);
  }

  /* ---------- Forest finale ---------- */
  .forest-section{
    position:relative;
    background:linear-gradient(to bottom, var(--sky-deep), #C9DCCB 30%, #B9D1BC);
    padding:6rem 0 0;
  }
  .forest-head{
    text-align:center;
    padding:0 1.5rem 3rem;
  }
  .forest-head h2{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(2.2rem,5.5vw,4rem);
    color:var(--pine);
  }
  .forest-head p{
    color:var(--ink-soft);
    max-width:52ch;
    margin:1rem auto 0;
  }
  .forest-wrap{position:relative}
  .forest-wrap svg{display:block;width:100%;height:auto}
  .metric-labels{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:1px;
    background:rgba(30,70,51,.15);
    border-top:1px solid rgba(30,70,51,.15);
  }
  .metric-cell{
    background:#EDF4EA;
    padding:1.6rem 1.2rem 1.8rem;
    text-align:center;
    display:flex;
    flex-direction:column-reverse;
    gap:.45rem;
  }
  .metric-cell dd{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(1.6rem,3vw,2.3rem);
    color:var(--pine);
    line-height:1;
  }
  .metric-cell dt{
    font-size:.78rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--ink-soft);
    font-weight:500;
  }

  /* ---------- Repos & locations ---------- */
  .detail{
    background:#EDF4EA;
    padding:5rem 1.5rem 6rem;
  }
  .detail-inner{
    max-width:960px;
    margin:0 auto;
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:4rem;
  }
  .detail h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.7rem;
    color:var(--pine);
    margin-bottom:.4rem;
  }
  .detail .sub{font-size:.92rem;color:var(--ink-soft);margin-bottom:1.6rem}
  .repo-list{list-style:none;margin:0;padding:0}
  .repo-list li{
    padding:.65rem 0;
    border-bottom:1px dashed rgba(30,70,51,.22);
    font-size:.95rem;
  }
  .repo-row{
    display:grid;
    grid-template-columns:2ch 1fr auto;
    gap:1rem;
    align-items:center;
  }
  .repo-list .rank{
    font-family:var(--display);
    font-weight:600;
    color:var(--pine-light);
  }
  .repo-list .bar-wrap{position:relative;padding-bottom:.55rem}
  .repo-list .name{font-weight:500}
  .repo-list .bar{
    position:absolute;
    left:0;bottom:0;
    height:5px;
    border-radius:3px;
    background:linear-gradient(90deg,var(--leaf-young),var(--pine-light));
    width:0;
  }
  html[data-motion="full"] .repo-list .bar{
    transition:width 1.1s cubic-bezier(.22,.9,.3,1);
  }
  .repo-list .count{
    font-variant-numeric:tabular-nums;
    color:var(--ink-soft);
    font-size:.88rem;
  }
  .loc-list{list-style:none;display:flex;flex-wrap:wrap;gap:.55rem}
  .loc-list li{
    background:#fff;
    border:1px solid rgba(30,70,51,.16);
    border-radius:99px;
    padding:.42rem .95rem;
    font-size:.88rem;
  }

  /* ---------- Footer ---------- */
  footer{
    background:var(--pine);
    color:#DFEBDD;
    text-align:center;
    padding:3.5rem 1.5rem;
  }
  footer .f-title{
    font-family:var(--display);
    font-size:1.5rem;
    font-weight:600;
  }
  footer p{opacity:.75;font-size:.9rem;margin-top:.6rem}

  @media (max-width:760px){
    html[data-motion="full"] .chapter{padding:0 5vw;align-items:flex-end;padding-bottom:12vh}
    html[data-motion="full"] .chapter.right{justify-content:flex-start}
    .panel{max-width:100%}
    .detail-inner{grid-template-columns:1fr;gap:3rem}
  }

  /* ---------- Accessibility: skip link, focus, tools ---------- */
  .skip-link{
    position:absolute;
    left:1rem;
    top:-5rem;
    z-index:1000;
    background:var(--pine);
    color:#fff;
    padding:.7rem 1.1rem;
    border-radius:0 0 10px 10px;
    font-weight:600;
    text-decoration:none;
    transition:top .15s ease;
  }
  html[data-motion="full"] .skip-link{transition:none}
  .skip-link:focus{top:0}
  :focus-visible{
    outline:3px solid var(--pine);
    outline-offset:3px;
    border-radius:3px;
  }
  [tabindex="-1"]:focus{outline:none}
  :target{scroll-margin-top:1.5rem}

  .visually-hidden{
    position:absolute!important;
    width:1px;height:1px;
    padding:0;margin:-1px;
    overflow:hidden;
    clip:rect(0 0 0 0);
    clip-path:inset(50%);
    white-space:nowrap;border:0;
  }

  /* Page tools appear only when JS can wire them up. */
  .page-tools{
    display:none;
    width:100%;
    flex-wrap:wrap;
    align-items:center;
    justify-content:center;
    gap:.75rem 1.5rem;
    padding:.7rem 1rem;
    background:var(--card);
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(30,70,51,.16);
  }
  html.js .page-tools{display:flex}
  .motion-control{
    display:flex;
    align-items:center;
    gap:.5rem;
    font-size:.85rem;
    color:var(--ink);
  }
  .motion-control select{
    font:inherit;
    font-size:.85rem;
    padding:.3rem .6rem;
    border:1px solid var(--pine-light);
    border-radius:8px;
    background:#fff;
    color:var(--ink);
  }
  .chapter-nav ol{
    list-style:none;
    display:flex;
    flex-wrap:wrap;
    gap:.4rem .6rem;
    margin:0;padding:0;
    font-size:.85rem;
  }
  .chapter-nav a{
    color:var(--pine);
    text-decoration:none;
    padding:.25rem .65rem;
    border:1px solid rgba(30,70,51,.28);
    border-radius:99px;
  }
  .chapter-nav a:hover{background:#fff}

  /* Metrics summary status / error region. */
  .metrics-status{
    max-width:640px;
    margin:0 auto 1.6rem;
    padding:.9rem 1.2rem;
    text-align:center;
    color:var(--ink-soft);
    font-size:.95rem;
  }
  .metrics-status[hidden]{display:none}
  .metrics-status.error{
    color:#7A1A1A;
    background:#FBEAEA;
    border:1px solid #D08A8A;
    border-radius:10px;
    font-weight:500;
  }

  /* ---------- User preference media queries ---------- */
  @media (forced-colors:active){
    .panel,.metric-cell,.loc-list li,.chapter-nav a,.page-tools,.motion-control select{
      background:Canvas;color:CanvasText;border-color:CanvasText;backdrop-filter:none;
    }
    .skip-link{background:Canvas;color:CanvasText;border:1px solid CanvasText}
    :focus-visible{outline:3px solid Highlight;outline-offset:3px}
    .repo-list .bar{background:CanvasText}
  }
  @media (prefers-contrast:more){
    :root{--ink:#0B140E;--ink-soft:#20302A;--card:#fff}
    .panel,.metric-cell,.loc-list li{border-color:var(--pine);border-width:2px}
    .panel{box-shadow:none}
    .chapter-nav a,.motion-control select{border-color:var(--pine)}
  }
  @media (prefers-reduced-transparency:reduce){
    :root{--card:#fff}
    .panel,.stage-caption,.page-tools{backdrop-filter:none;background:#fff}
  }
</style>
<script>
/* Resolve the effective motion preference before first paint so the static
   baseline is the default and there is no flash of motion. Without JS this
   never runs, so the page stays in its static baseline. */
(function(){
  var d = document.documentElement;
  d.classList.remove('no-js');
  d.classList.add('js');
  var stored = null;
  try { stored = localStorage.getItem('yir-motion'); } catch (e) {}
  var systemReduce = false;
  try { systemReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
  var full;
  if (stored === 'full') full = true;
  else if (stored === 'reduce') full = false;
  else full = !systemReduce;               /* follow system */
  d.setAttribute('data-motion', full ? 'full' : 'reduced');
})();
</script>
</head>
<body>

<a class="skip-link" href="#metrics">Skip animated story</a>

<!-- ============ HERO ============ -->
<header class="hero">
  <div class="page-tools">
    <div class="motion-control">
      <label for="motionPref">Motion</label>
      <select id="motionPref">
        <option value="system">Follow system</option>
        <option value="reduce">Reduce motion</option>
        <option value="full">Full motion</option>
      </select>
    </div>
    <nav class="chapter-nav" aria-label="Chapters">
      <ol role="list">
        <li><a href="#chapter-roots">Roots</a></li>
        <li><a href="#chapter-heat">Heat</a></li>
        <li><a href="#chapter-light">Light</a></li>
        <li><a href="#chapter-love">Love</a></li>
      </ol>
    </nav>
  </div>
  <div class="eyebrow" id="eyebrowPeriod">Year in Review</div>
  <h1>Every commit is a <em>seed.</em></h1>
  <p><span id="durationLabel">Twelve months</span> of Open Source activity, told as it happened: something small, planted in spring, that would not stop growing.</p>
  <svg class="seed" viewBox="0 0 64 64" aria-hidden="true">
    <path d="M32 54 V34" stroke="#3A6B4E" stroke-width="3" stroke-linecap="round"/>
    <path d="M32 38 C 24 34, 20 26, 22 18 C 30 20, 34 28, 32 38 Z" fill="#8FB878"/>
    <path d="M32 34 C 40 30, 44 22, 42 14 C 34 16, 30 24, 32 34 Z" fill="#5D8F5F"/>
    <ellipse cx="32" cy="56" rx="14" ry="3.5" fill="#6B4A32" opacity=".35"/>
  </svg>
  <div class="scroll-hint">Scroll or use Page Down to follow the story</div>
</header>

<main id="main">

<!-- ============ GROWTH TRACK ============ -->
<section class="growth-track" id="track" aria-labelledby="story-heading">
  <h2 id="story-heading" class="visually-hidden">The growth story</h2>
  <div class="tree-stage" id="stage">
    <div class="stage-caption" id="caption" aria-hidden="true">Spring · a sapling takes root</div>
    <svg id="treeSvg" viewBox="0 0 800 700" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
      <!-- sun (rises during Light chapter) -->
      <g id="sunGroup" opacity="0">
        <circle id="sunCore" cx="640" cy="180" r="42" fill="var(--sun)"/>
        <g id="sunRays" stroke="var(--sun)" stroke-width="4" stroke-linecap="round" opacity=".8"></g>
      </g>

      <!-- ground -->
      <path d="M0 648 Q 400 630 800 648 L 800 700 L 0 700 Z" fill="#AECBA8"/>
      <ellipse cx="400" cy="648" rx="150" ry="12" fill="#8FB878" opacity=".5"/>

      <!-- trunk & branches (drawn by scroll in full motion) -->
      <g id="wood" fill="none" stroke="var(--bark)" stroke-linecap="round">
        <path class="grow" data-start="0.00" data-end="0.30" stroke-width="26"
              d="M400 650 C 398 560, 404 470, 398 380 C 395 320, 400 280, 402 240"/>
        <path class="grow" data-start="0.16" data-end="0.42" stroke-width="13"
              d="M399 470 C 360 440, 320 420, 285 375"/>
        <path class="grow" data-start="0.20" data-end="0.46" stroke-width="13"
              d="M400 430 C 445 400, 490 385, 520 340"/>
        <path class="grow" data-start="0.30" data-end="0.56" stroke-width="9"
              d="M300 392 C 275 365, 255 335, 250 300"/>
        <path class="grow" data-start="0.34" data-end="0.60" stroke-width="9"
              d="M505 352 C 535 325, 555 295, 558 262"/>
        <path class="grow" data-start="0.38" data-end="0.62" stroke-width="10"
              d="M402 300 C 380 260, 360 235, 330 210"/>
        <path class="grow" data-start="0.42" data-end="0.66" stroke-width="10"
              d="M402 275 C 425 235, 450 210, 480 190"/>
        <path class="grow" data-start="0.46" data-end="0.70" stroke-width="8"
              d="M402 240 C 400 205, 398 180, 396 150"/>
      </g>

      <!-- canopy clusters (scale in) -->
      <g id="canopy"></g>
      <!-- blossoms (Love chapter) -->
      <g id="blossoms"></g>
    </svg>
  </div>

  <!-- chapter panels: normal flow by default, overlay the stage in full motion -->
  <div class="chapters">
    <div class="chapter">
      <div class="panel">
        <p class="tag">Chapter 1 · Roots</p>
        <h3 id="chapter-roots" tabindex="-1">It started small.</h3>
        <p>One trunk, a handful of maintainers, and a habit of shipping. Keep reading — every branch you see is earned.</p>
      </div>
    </div>
    <div class="chapter right">
      <div class="panel">
        <p class="tag">Chapter 2 · Heat 🔥</p>
        <h3 id="chapter-heat" tabindex="-1">Heat means work.</h3>
        <p>Commits and committers are the pulse of a project — the raw effort that makes wood.</p>
        <div class="stat-row">
          <div class="stat"><b data-count data-key="heat.commits">—</b><span>commits</span></div>
          <div class="stat"><b data-count data-key="heat.committers">—</b><span>committers</span></div>
        </div>
      </div>
    </div>
    <div class="chapter">
      <div class="panel">
        <p class="tag">Chapter 3 · Light ☀️</p>
        <h3 id="chapter-light" tabindex="-1">Light means visibility.</h3>
        <p>Watchers subscribe to every change; stars are bookmarks of belief. The canopy turns toward the sun.</p>
        <div class="stat-row">
          <div class="stat"><b data-count data-key="light.watchers">—</b><span>watchers</span></div>
          <div class="stat"><b data-count data-key="light.stars">—</b><span>stars</span></div>
        </div>
      </div>
    </div>
    <div class="chapter right">
      <div class="panel">
        <p class="tag">Chapter 4 · Love 🌸</p>
        <h3 id="chapter-love" tabindex="-1">Love means culture.</h3>
        <p>Forks carry the project into new soil, and merged PRs bring it home again. This is where a tree blossoms.</p>
        <div class="stat-row">
          <div class="stat"><b data-count data-key="love.forks">—</b><span>forks</span></div>
          <div class="stat"><b data-count data-key="love.prsMerged">—</b><span>PRs merged</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============ FOREST FINALE / METRICS SUMMARY ============ -->
<section class="forest-section" id="metrics" tabindex="-1" aria-labelledby="metrics-heading">
  <div class="forest-head">
    <h2 id="metrics-heading">One tree became a forest.</h2>
    <p>Step back, and each metric is its own tree — sized by what it grew into this year. The numbers below are the full total for the reporting period.</p>
  </div>
  <p class="metrics-status" id="metricsStatus">Loading the year’s metrics…</p>
  <div class="forest-wrap">
    <svg id="forestSvg" viewBox="0 0 1200 420" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false"></svg>
  </div>
  <dl class="metric-labels" id="metricLabels">
    <div class="metric-cell"><dt>Commits</dt><dd data-metric="heat.commits">—</dd></div>
    <div class="metric-cell"><dt>Committers</dt><dd data-metric="heat.committers">—</dd></div>
    <div class="metric-cell"><dt>Watchers</dt><dd data-metric="light.watchers">—</dd></div>
    <div class="metric-cell"><dt>Stars</dt><dd data-metric="light.stars">—</dd></div>
    <div class="metric-cell"><dt>Forks</dt><dd data-metric="love.forks">—</dd></div>
    <div class="metric-cell"><dt>PRs merged</dt><dd data-metric="love.prsMerged">—</dd></div>
  </dl>
</section>

<!-- ============ REPOS & LOCATIONS ============ -->
<section class="detail" aria-labelledby="detail-heading">
  <h2 id="detail-heading" class="visually-hidden">A closer look at the grove</h2>
  <div class="detail-inner">
    <div>
      <h3>The tallest trees</h3>
      <p class="sub">Top repositories, ranked by total commits.</p>
      <ol class="repo-list" id="repoList" role="list"></ol>
    </div>
    <div>
      <h3>Where the forest grows</h3>
      <p class="sub">Contributor locations, self-reported on GitHub profiles.</p>
      <ul class="loc-list" id="locList" role="list"></ul>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="f-title">Heat 🔥 &nbsp; Light ☀️ &nbsp; Love 🌸</div>
  <p>A year of growth in open source. Data updates with each release — patches always welcome.</p>
</footer>

<noscript>
  <p style="max-width:640px;margin:1.5rem auto;padding:1rem 1.2rem;text-align:center;color:#4A5A50">
    The live metrics and the animated tree need JavaScript. The story text above still
    describes the year of growth.
  </p>
</noscript>

<script type="module">
import { loadYearInReviewData } from './metrics-data.js';

// Populated from the generated metrics JSON once loadYearInReviewData()
// resolves (see the bottom of this script) — everything on the page
// renders from this.
let DATA = null;
let contentBuilt = false;

const root = document.documentElement;
const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
const NS = 'http://www.w3.org/2000/svg';
const fmt = n => n >= 1000 ? (n >= 100000 ? Math.round(n/1000)+'k' : (n/1000).toFixed(n%1000===0?0:1).replace(/\.0$/,'')+'k') : n.toLocaleString();
const get = (obj, path) => path.split('.').reduce((o,k)=>o[k], obj);
const clamp01 = v => Math.max(0, Math.min(1, v));
const ease = t => t<.5 ? 2*t*t : 1-Math.pow(-2*t+2,2)/2;
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
// Formats a "YYYY-MM-DD" string directly from its parts (no Date object)
// so it can't shift a day depending on the viewer's timezone.
const formatPeriodDate = iso => {
  const [y, m, d] = iso.split('-').map(Number);
  return `${MONTHS[m-1]} ${d}, ${y}`;
};
const toUTCDate = iso => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(Date.UTC(y, m-1, d));
};
const formatDuration = (startIso, endIso) => {
  const days = Math.round((toUTCDate(endIso) - toUTCDate(startIso)) / 86400000);
  if (days < 60) {
    const weeks = Math.max(1, Math.round(days / 7));
    return `${weeks} week${weeks === 1 ? '' : 's'}`;
  }
  const months = Math.max(1, Math.round(days / 30.44));
  return `${months} month${months === 1 ? '' : 's'}`;
};

/* ---------------- Sun rays ---------------- */
(function buildSun(){
  const rays = document.getElementById('sunRays');
  for(let i=0;i<12;i++){
    const a = i * Math.PI/6;
    const x1 = 640 + Math.cos(a)*54, y1 = 180 + Math.sin(a)*54;
    const x2 = 640 + Math.cos(a)*70, y2 = 180 + Math.sin(a)*70;
    const l = document.createElementNS('http://www.w3.org/2000/svg','line');
    l.setAttribute('x1',x1); l.setAttribute('y1',y1);
    l.setAttribute('x2',x2); l.setAttribute('y2',y2);
    rays.appendChild(l);
  }
})();

/* ---------------- Canopy clusters ---------------- */
const CANOPY = [
  // [cx, cy, r, start, end, color]
  [285, 355, 52, 0.34, 0.52, 'var(--leaf-young)'],
  [250, 285, 46, 0.44, 0.62, 'var(--leaf)'],
  [520, 325, 55, 0.38, 0.56, 'var(--leaf-young)'],
  [558, 248, 46, 0.48, 0.66, 'var(--leaf)'],
  [330, 198, 58, 0.52, 0.70, 'var(--leaf)'],
  [480, 178, 58, 0.55, 0.73, 'var(--leaf)'],
  [400, 135, 72, 0.58, 0.78, 'var(--pine-light)'],
  [400, 250, 80, 0.50, 0.72, 'var(--leaf)'],
  [340, 300, 55, 0.46, 0.66, 'var(--leaf-young)'],
  [460, 280, 55, 0.48, 0.68, 'var(--leaf)']
];
(function buildCanopy(){
  const g = document.getElementById('canopy');
  CANOPY.forEach(([cx,cy,r,s,e,fill])=>{
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('cx',cx); c.setAttribute('cy',cy); c.setAttribute('r',r);
    c.setAttribute('fill',fill); c.setAttribute('opacity','0.92');
    c.dataset.start=s; c.dataset.end=e;
    c.style.transformOrigin = `${cx}px ${cy}px`;
    g.appendChild(c);
  });
})();

/* ---------------- Blossoms ---------------- */
(function buildBlossoms(){
  const g = document.getElementById('blossoms');
  let seed = 7;
  const rand = () => (seed = (seed*16807) % 2147483647) / 2147483647;
  for(let i=0;i<26;i++){
    const base = CANOPY[Math.floor(rand()*CANOPY.length)];
    const a = rand()*Math.PI*2, d = rand()*base[2]*0.85;
    const cx = base[0]+Math.cos(a)*d, cy = base[1]+Math.sin(a)*d;
    const c = document.createElementNS('http://www.w3.org/2000/svg','circle');
    c.setAttribute('cx',cx); c.setAttribute('cy',cy);
    c.setAttribute('r', 4 + rand()*3.5);
    c.setAttribute('fill','var(--blossom)');
    c.dataset.start = 0.72 + rand()*0.12;
    c.dataset.end = +c.dataset.start + 0.08;
    c.style.transformOrigin = `${cx}px ${cy}px`;
    g.appendChild(c);
  }
})();

/* ---------------- Scroll-driven growth ---------------- */
const track = document.getElementById('track');
const woodPaths = [...document.querySelectorAll('#wood .grow')];
woodPaths.forEach(p=>{
  const len = p.getTotalLength();
  p.dataset.len = len;
  p.style.strokeDasharray = len;
});
const scalables = [...document.querySelectorAll('#canopy circle, #blossoms circle')];
const sunGroup = document.getElementById('sunGroup');
const sunRays = document.getElementById('sunRays');
const caption = document.getElementById('caption');
const CAPTIONS = [
  [0.00, 'Spring · a sapling takes root'],
  [0.22, 'Summer · heat makes wood 🔥'],
  [0.46, 'The canopy turns to the light ☀️'],
  [0.70, 'Autumn · the tree blossoms 🌸'],
  [0.92, 'Keep going — the forest is ahead']
];

function renderTree(){
  const rect = track.getBoundingClientRect();
  const total = rect.height - window.innerHeight;
  const progress = clamp01(-rect.top / total);

  // wood strokes
  for(const p of woodPaths){
    const t = ease(clamp01((progress - +p.dataset.start) / (+p.dataset.end - +p.dataset.start)));
    p.style.strokeDashoffset = p.dataset.len * (1 - t);
  }
  // canopy + blossoms
  for(const c of scalables){
    const t = ease(clamp01((progress - +c.dataset.start) / (+c.dataset.end - +c.dataset.start)));
    c.style.transform = `scale(${t})`;
  }
  // sun rises 0.40 → 0.62
  const sunT = ease(clamp01((progress - 0.40) / 0.22));
  sunGroup.setAttribute('opacity', sunT);
  sunGroup.setAttribute('transform', `translate(0 ${(1 - sunT) * 90})`);
  sunRays.setAttribute('transform', `rotate(${progress * 40} 640 180)`);
  // caption
  let label = CAPTIONS[0][1];
  for(const [at, text] of CAPTIONS) if(progress >= at) label = text;
  if(caption.textContent !== label) caption.textContent = label;
}

/* Static ("complete, stationary tree") vs. animation-start scene states. */
function sceneStatic(){
  woodPaths.forEach(p=> p.style.strokeDashoffset = 0);
  scalables.forEach(c=> c.style.transform = 'scale(1)');
  sunGroup.setAttribute('opacity','1');
  sunGroup.setAttribute('transform','translate(0 0)');
  sunRays.setAttribute('transform','rotate(0 640 180)');
  caption.textContent = CAPTIONS[0][1];
}
function sceneStart(){
  woodPaths.forEach(p=> p.style.strokeDashoffset = p.dataset.len);
  scalables.forEach(c=> c.style.transform = 'scale(0)');
  sunGroup.setAttribute('opacity','0');
}

/* ---------------- Motion state machine ---------------- */
const countEls = () => [...document.querySelectorAll('[data-count]')];
let forestTrees = [];
let repoBars = [];
let scrollHandler = null, resizeHandler = null;
let panelObserver = null, forestObserver = null, repoBarObserver = null;

function isFull(){ return root.getAttribute('data-motion') === 'full'; }

function countsFinal(){ if(DATA) countEls().forEach(el=> el.textContent = fmt(get(DATA, el.dataset.key))); }
function barsFinal(){ repoBars.forEach(b=> b.style.width = b.dataset.w + '%'); }
function barsStart(){ repoBars.forEach(b=> b.style.width = '0%'); }
function forestFinal(){ forestTrees.forEach(g=>{ g.style.transition='none'; g.style.transform='scale(1)'; }); }
function forestStart(){ forestTrees.forEach((g,i)=>{ g.style.transition=`transform .9s cubic-bezier(.2,1.1,.3,1) ${i*0.12}s`; g.style.transform='scale(0)'; }); }

function startCount(el){
  const target = get(DATA, el.dataset.key);
  const dur = 1400, t0 = performance.now();
  (function tick(now){
    if(!isFull()){ el.textContent = fmt(target); return; }   // stop cleanly if motion is turned off
    const t = ease(clamp01((now - t0)/dur));
    el.textContent = fmt(Math.round(target * t));
    if(t < 1) requestAnimationFrame(tick);
  })(t0);
}

function attachFull(){
  let ticking = false;
  scrollHandler = ()=>{ if(!ticking){ ticking = true; requestAnimationFrame(()=>{ ticking = false; renderTree(); }); } };
  resizeHandler = renderTree;
  window.addEventListener('scroll', scrollHandler, { passive:true });
  window.addEventListener('resize', resizeHandler);
  renderTree();

  panelObserver = new IntersectionObserver(entries=>{
    entries.forEach(en=>{
      if(en.isIntersecting){
        en.target.classList.add('in');
        en.target.querySelectorAll('[data-count]').forEach(startCount);
        panelObserver.unobserve(en.target);
      }
    });
  },{ threshold:0.4 });
  document.querySelectorAll('.panel').forEach(p=>panelObserver.observe(p));

  if(forestTrees.length){
    const svg = document.getElementById('forestSvg');
    forestObserver = new IntersectionObserver(entries=>{
      entries.forEach(en=>{ if(en.isIntersecting){ forestTrees.forEach(g=>g.style.transform='scale(1)'); forestObserver.disconnect(); } });
    },{ threshold:0.3 });
    forestObserver.observe(svg);
  }
  if(repoBars.length){
    const list = document.getElementById('repoList');
    repoBarObserver = new IntersectionObserver(entries=>{
      entries.forEach(en=>{ if(en.isIntersecting){ barsFinal(); repoBarObserver.disconnect(); } });
    },{ threshold:0.2 });
    repoBarObserver.observe(list);
  }
}

function detachFull(){
  if(scrollHandler){ window.removeEventListener('scroll', scrollHandler); scrollHandler = null; }
  if(resizeHandler){ window.removeEventListener('resize', resizeHandler); resizeHandler = null; }
  [panelObserver, forestObserver, repoBarObserver].forEach(o=> o && o.disconnect());
  panelObserver = forestObserver = repoBarObserver = null;
  document.querySelectorAll('.panel.in').forEach(p=>p.classList.remove('in'));
}

/* ---------------- Motion preference control ---------------- */
const select = document.getElementById('motionPref');
const STORE_KEY = 'yir-motion';
function readStored(){ try { return localStorage.getItem(STORE_KEY); } catch(e){ return null; } }
function writeStored(v){ try { if(v) localStorage.setItem(STORE_KEY, v); else localStorage.removeItem(STORE_KEY); } catch(e){} }
function effectiveFull(pref){
  if(pref === 'full') return true;
  if(pref === 'reduce') return false;
  return !mq.matches;                          // follow system
}

function applyMotion(){
  const pref = select ? select.value : 'system';
  const full = effectiveFull(pref);
  root.setAttribute('data-motion', full ? 'full' : 'reduced');
  detachFull();
  if(!contentBuilt){
    if(full) sceneStart(); else sceneStatic();   // baseline tree before data arrives
    return;
  }
  if(full){
    sceneStart(); forestStart(); barsStart(); countsFinal();
    attachFull();
  } else {
    sceneStatic(); forestFinal(); barsFinal(); countsFinal();
  }
}

if(select){
  select.value = readStored() || 'system';
  select.addEventListener('change', ()=>{
    writeStored(select.value === 'system' ? null : select.value);
    applyMotion();
  });
}
const onSystemChange = ()=>{ if((select ? select.value : 'system') === 'system') applyMotion(); };
if(mq.addEventListener) mq.addEventListener('change', onSystemChange);
else if(mq.addListener) mq.addListener(onSystemChange);

// Set the initial scene before data arrives (avoids a flash of motion).
applyMotion();

/* ---------------- Forest finale ---------------- */
const METRICS = [
  { label:'Commits',    key:'heat.commits',   hue:'#2F5D40' },
  { label:'Committers', key:'heat.committers',hue:'#5D8F5F' },
  { label:'Watchers',   key:'light.watchers', hue:'#3A6B4E' },
  { label:'Stars',      key:'light.stars',    hue:'#2F5D40' },
  { label:'Forks',      key:'love.forks',     hue:'#5D8F5F' },
  { label:'PRs merged', key:'love.prsMerged', hue:'#3A6B4E' }
];
function buildForest(){
  const svg = document.getElementById('forestSvg');
  const W = 1200, groundY = 380;
  const vals = METRICS.map(m=>get(DATA, m.key));
  const maxLog = Math.max(...vals.map(v=>Math.log10(v)));

  // soft background treeline for depth
  let seed = 13;
  const rand = () => (seed = (seed*16807) % 2147483647) / 2147483647;
  for(let i=0;i<22;i++){
    const x = 30 + rand()*(W-60), h = 40 + rand()*70, w = h*0.55;
    const t = document.createElementNS(NS,'path');
    t.setAttribute('d', `M${x} ${groundY-4} L${x-w/2} ${groundY-4} L${x} ${groundY-4-h} L${x+w/2} ${groundY-4} Z`);
    t.setAttribute('fill', '#9BBE9B');
    t.setAttribute('opacity', 0.35 + rand()*0.2);
    svg.appendChild(t);
  }
  // ground
  const ground = document.createElementNS(NS,'path');
  ground.setAttribute('d', `M0 ${groundY} Q ${W/2} ${groundY-14} ${W} ${groundY} L ${W} 420 L 0 420 Z`);
  ground.setAttribute('fill', '#8FB878');
  svg.appendChild(ground);

  // metric trees
  const slot = W / METRICS.length;
  METRICS.forEach((m, i)=>{
    const v = get(DATA, m.key);
    const h = 90 + 210 * (Math.log10(v) / maxLog);   // log scale so small metrics still stand tall
    const x = slot*i + slot/2;
    const g = document.createElementNS(NS,'g');
    g.classList.add('m-tree');
    g.style.transformOrigin = `${x}px ${groundY}px`;
    forestTrees.push(g);

    const trunk = document.createElementNS(NS,'rect');
    const tw = 10 + h*0.03;
    trunk.setAttribute('x', x-tw/2); trunk.setAttribute('y', groundY-h*0.5);
    trunk.setAttribute('width', tw); trunk.setAttribute('height', h*0.5);
    trunk.setAttribute('rx', tw/2.5);
    trunk.setAttribute('fill', 'var(--bark)');
    g.appendChild(trunk);

    // layered canopy
    const layers = 3;
    for(let l=0; l<layers; l++){
      const ly = groundY - h*0.42 - (h*0.55)*(l/layers);
      const lr = (h*0.30) * (1 - l*0.22);
      const c = document.createElementNS(NS,'ellipse');
      c.setAttribute('cx', x); c.setAttribute('cy', ly);
      c.setAttribute('rx', lr*1.15); c.setAttribute('ry', lr);
      c.setAttribute('fill', m.hue);
      c.setAttribute('opacity', 0.95);
      g.appendChild(c);
    }
    // value floating above
    const txt = document.createElementNS(NS,'text');
    txt.setAttribute('x', x);
    txt.setAttribute('y', groundY - h - 16);
    txt.setAttribute('text-anchor','middle');
    txt.setAttribute('font-family','Fraunces, Georgia, serif');
    txt.setAttribute('font-size','26');
    txt.setAttribute('font-weight','700');
    txt.setAttribute('fill','var(--pine)');
    txt.textContent = fmt(v);
    g.appendChild(txt);

    const lbl = document.createElementNS(NS,'text');
    lbl.setAttribute('x', x);
    lbl.setAttribute('y', groundY + 26);
    lbl.setAttribute('text-anchor','middle');
    lbl.setAttribute('font-family','Outfit, sans-serif');
    lbl.setAttribute('font-size','13');
    lbl.setAttribute('letter-spacing','2');
    lbl.setAttribute('fill','var(--ink-soft)');
    lbl.textContent = m.label.toUpperCase();
    g.appendChild(lbl);

    svg.appendChild(g);
  });

  forestFinal();
}

/* Fill the semantic metrics summary (the accessible source of the numbers). */
function fillMetricSummary(){
  document.querySelectorAll('[data-metric]').forEach(el=>{
    el.textContent = fmt(get(DATA, el.dataset.metric));
  });
}

/* ---------------- Repo list & locations ---------------- */
function buildRepos(){
  const list = document.getElementById('repoList');
  const max = Math.max(...DATA.topRepos.map(r=>r.commits));
  DATA.topRepos.forEach((r,i)=>{
    const li = document.createElement('li');
    const row = document.createElement('div');
    row.className = 'repo-row';
    const rank = document.createElement('span');
    rank.className = 'rank';
    rank.textContent = i+1;
    const barWrap = document.createElement('span');
    barWrap.className = 'bar-wrap';
    const name = document.createElement('span');
    name.className = 'name';
    name.textContent = r.name;
    const bar = document.createElement('span');
    bar.className = 'bar';
    bar.dataset.w = (r.commits/max*100).toFixed(1);
    bar.setAttribute('aria-hidden','true');
    barWrap.append(name, bar);
    const count = document.createElement('span');
    count.className = 'count';
    count.textContent = r.commits.toLocaleString();
    row.append(rank, barWrap, count);
    li.appendChild(row);
    list.appendChild(li);
    repoBars.push(bar);
  });
  barsFinal();
}

function buildLocations(){
  const loc = document.getElementById('locList');
  DATA.locations.forEach(l=>{
    const li = document.createElement('li');
    li.textContent = l;
    loc.appendChild(li);
  });
}

loadYearInReviewData().then((data) => {
  const status = document.getElementById('metricsStatus');
  const failed = !data || data.error || !data.period || !data.period.start;
  if(failed){
    if(status){
      status.textContent = 'The year’s metrics are unavailable right now. Please try again later.';
      status.classList.add('error');
      status.hidden = false;
    }
    const rl = document.getElementById('repoList');
    if(rl && !rl.children.length){
      const li = document.createElement('li'); li.textContent = 'Repository data is unavailable.'; rl.appendChild(li);
    }
    const ll = document.getElementById('locList');
    if(ll && !ll.children.length){
      const li = document.createElement('li'); li.textContent = 'Location data is unavailable.'; ll.appendChild(li);
    }
    return;
  }

  DATA = data;
  document.getElementById('eyebrowPeriod').textContent =
    `${formatPeriodDate(data.period.start)} — ${formatPeriodDate(data.period.end)} · Year in Review`;
  document.getElementById('durationLabel').textContent = formatDuration(data.period.start, data.period.end);

  fillMetricSummary();
  buildForest();
  buildRepos();
  buildLocations();
  contentBuilt = true;

  if(status) status.hidden = true;
  applyMotion();
}).catch(() => {
  const status = document.getElementById('metricsStatus');
  if(status){
    status.textContent = 'The year’s metrics are unavailable right now. Please try again later.';
    status.classList.add('error');
    status.hidden = false;
  }
});
</script>
</body>
</html>
