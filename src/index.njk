        </svg>
        <span>Chapters</span>
        <svg class="tool-chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false"><path d="M0 0h10L5 6z"/></svg>
      </button>
      <nav class="tool-panel chapter-nav" id="chaptersPanel" aria-label="Chapters" hidden>
        <ol role="list">
          <li><a href="#chapter-roots">Roots</a></li>
          <li><a href="#chapter-heat">Heat</a></li>
          <li><a href="#chapter-light">Light</a></li>
          <li><a href="#chapter-love">Love</a></li>
