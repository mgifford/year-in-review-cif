<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ org.name }} — Year in Review</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --sky:#E8F0E4;
    --sky-deep:#D5E4DB;
    --pine:#1E4633;
    --pine-light:#3A6B4E;
    --leaf:#5D8F5F;
    --leaf-young:#8FB878;
    --bark:#6B4A32;
    --sun:#E8B34B;
    --blossom:#E58FA2;
    --ink:#1B2A22;
    --ink-soft:#4A5A50;
    --surface:#ffffff;
    --card:rgba(255,255,255,0.82);
    --tint:#EDF4EA;
    --sky-top:#F2F6EC;
    --forest-mid:#C9DCCB;
    --forest-deep:#B9D1BC;
    --on-pine:#ffffff;
    --line:rgba(30,70,51,.16);
    --line-strong:rgba(30,70,51,.28);
    --error-fg:#7A1A1A;
    --error-bg:#FBEAEA;
    --error-line:#D08A8A;
    --viz-1:#2F5D40;
    --viz-2:#5D8F5F;
    --viz-3:#3A6B4E;
    --viz-tree:#9BBE9B;
    --viz-ground:#8FB878;
    --display:'Fraunces', Georgia, 'Times New Roman', serif;
    --body:'Outfit', -apple-system, 'Segoe UI', sans-serif;
  }

  /* Dark palette. The pre-paint script resolves "follow system" to an explicit
     data-theme, so only this one selector is needed once JS runs. */
  html[data-theme="dark"]{
    --sky:#0F1713;
    --sky-deep:#16221B;
    --pine:#9FD3B0;
    --pine-light:#7FB894;
    --leaf:#7FB08A;
    --leaf-young:#B9DC9E;
    --bark:#C09070;
    --sun:#F0C46A;
    --blossom:#F0A3B4;
    --ink:#E7EFE9;
    --ink-soft:#B3C6B9;
    --surface:#1B2A22;
    --card:rgba(27,42,34,.86);
    --tint:#15221B;
    --sky-top:#16241C;
    --forest-mid:#132019;
    --forest-deep:#0C140F;
    --on-pine:#08120C;
    --line:rgba(159,211,176,.24);
    --line-strong:rgba(159,211,176,.42);
    --error-fg:#FFC9C9;
    --error-bg:#33191B;
    --error-line:#96585A;
    --viz-1:#8FBF9E;
    --viz-2:#B3D89B;
    --viz-3:#7FB894;
    --viz-tree:#6E9478;
    --viz-ground:#5D8F5F;
    color-scheme:dark;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:auto}
  html[data-motion="full"]{scroll-behavior:smooth}
  body{
    font-family:var(--body);
    color:var(--ink);
    background:var(--sky);
    overflow-x:hidden;
    line-height:1.6;
  }
  ::selection{background:var(--sun);color:var(--ink)}

  /* ---------- Hero ---------- */
  .hero{
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:2rem 1.5rem;
    position:relative;
  }
  .org-badge{
    display:flex;
    align-items:center;
    gap:.7rem;
    margin:0 0 1.6rem;
  }
  .org-logo{
    width:2.6rem;height:2.6rem;
    border-radius:8px;
    background:var(--surface);
  }
  .org-name{
    font-family:var(--display);
    font-weight:600;
    font-size:1.35rem;
    color:var(--pine);
    text-decoration:none;
  }
  .org-name:hover{text-decoration:underline}
  .hero .eyebrow{
    font-size:.85rem;
    letter-spacing:.28em;
    text-transform:uppercase;
    color:var(--pine-light);
    font-weight:600;
    margin-bottom:1.2rem;
  }
  .hero h1{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(2.8rem, 8vw, 6rem);
    line-height:1.02;
    color:var(--pine);
    max-width:14ch;
  }
  .hero h1 em{
    font-style:italic;
    color:var(--bark);
  }
  .hero p{
    margin-top:1.4rem;
    max-width:44ch;
    color:var(--ink-soft);
    font-size:1.05rem;
  }
  .seed{
    margin-top:2.4rem;
    width:64px;height:64px;
  }
  /* Finite, self-stopping (< 5s) idle motion; only when full motion is on. */
  html[data-motion="full"] .seed{
    animation:bob 2.4s ease-in-out 2;
  }
  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
  .scroll-hint{
    position:absolute;
    bottom:2rem;
    font-size:.8rem;
    letter-spacing:.2em;
    text-transform:uppercase;
    color:var(--ink-soft);
  }
  .scroll-hint::after{
    content:'';
    display:block;
    width:1px;height:34px;
    background:var(--ink-soft);
    margin:.6rem auto 0;
    transform-origin:top;
  }
  html[data-motion="full"] .scroll-hint::after{
    animation:drip 1.6s ease-in-out 3;
  }
  @keyframes drip{0%{transform:scaleY(0)}50%{transform:scaleY(1)}100%{transform:scaleY(0)}}

  /* ---------- Growth track ----------
     Base (no-JS / reduced motion): normal document flow, static tree.
     Full motion only: tall scroll runway + sticky stage. */
  .growth-track{
    position:relative;
    background:linear-gradient(to top, var(--sky-deep) 0%, var(--sky) 55%, var(--sky-top) 100%);
  }
  html[data-motion="full"] .growth-track{
    /* tall runway: the tree grows across this whole distance */
    height:520vh;
    background:none;
  }
  .tree-stage{
    position:relative;
    width:100%;
    overflow:hidden;
  }
  html[data-motion="full"] .tree-stage{
    position:sticky;
    top:0;
    height:100vh;
    background:linear-gradient(to top, var(--sky-deep) 0%, var(--sky) 55%, var(--sky-top) 100%);
  }
  .tree-stage svg{
    display:block;
    width:100%;
    height:auto;
    max-height:70vh;
    margin:0 auto;
  }
  html[data-motion="full"] .tree-stage svg{
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
    max-height:none;
  }
  .stage-caption{
    position:absolute;
    top:1.4rem;
    left:50%;
    transform:translateX(-50%);
    font-size:.78rem;
    letter-spacing:.26em;
    text-transform:uppercase;
    color:var(--pine-light);
    font-weight:600;
    background:var(--card);
    padding:.45rem 1.1rem;
    border-radius:99px;
    backdrop-filter:blur(6px);
    white-space:nowrap;
  }

  /* Chapters: normal flow by default; overlay the sticky stage only in full motion. */
  .chapters{
    position:relative;
    max-width:960px;
    margin:0 auto;
    padding:2rem 1.5rem 3rem;
    display:grid;
    gap:1.5rem;
  }
  html[data-motion="full"] .chapters{
    position:absolute;
    inset:0;
    max-width:none;
    margin:0;
    padding:0;
    display:block;
    pointer-events:none;
  }
  .chapter{display:block}
  html[data-motion="full"] .chapter{
    height:130vh;
    display:flex;
    align-items:center;
    padding:0 6vw;
  }
  html[data-motion="full"] .chapter:first-child{height:110vh}
  html[data-motion="full"] .chapter.right{justify-content:flex-end}
  .panel{
    pointer-events:auto;
    max-width:380px;
    background:var(--card);
    backdrop-filter:blur(10px);
    border:1px solid var(--line);
    border-radius:18px;
    padding:1.8rem 1.9rem;
    box-shadow:0 18px 44px -18px rgba(27,42,34,.25);
  }
  /* Full motion: panels start hidden and animate in on scroll. */
  html[data-motion="full"] .panel{
    opacity:0;
    transform:translateY(36px);
    transition:opacity .7s ease, transform .7s cubic-bezier(.22,.9,.3,1);
  }
  html[data-motion="full"] .panel.in{opacity:1;transform:translateY(0)}
  .panel .tag{
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    font-size:.72rem;
    letter-spacing:.22em;
    text-transform:uppercase;
    font-weight:600;
    color:var(--pine-light);
    margin-bottom:.7rem;
  }
  .panel h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.9rem;
    color:var(--pine);
    line-height:1.1;
    margin-bottom:.6rem;
  }
  .panel p{font-size:.95rem;color:var(--ink-soft)}
  .panel .stat-row{
    display:flex;
    gap:1.6rem;
    margin-top:1.2rem;
    padding-top:1.1rem;
    border-top:1px dashed var(--line-strong);
  }
  .panel .stat b{
    display:block;
    font-family:var(--display);
    font-size:1.7rem;
    font-weight:700;
    color:var(--ink);
    line-height:1;
  }
  .panel .stat span{
    font-size:.78rem;
    letter-spacing:.05em;
    color:var(--ink-soft);
  }

  /* ---------- Forest finale ---------- */
  .forest-section{
    position:relative;
    background:linear-gradient(to bottom, var(--sky-deep), var(--forest-mid) 30%, var(--forest-deep));
    padding:6rem 0 0;
  }
  .forest-head{
    text-align:center;
    padding:0 1.5rem 3rem;
  }
  .forest-head h2{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(2.2rem,5.5vw,4rem);
    color:var(--pine);
  }
  .forest-head p{
    color:var(--ink-soft);
    max-width:52ch;
    margin:1rem auto 0;
  }
  .forest-wrap{position:relative}
  .forest-wrap svg{display:block;width:100%;height:auto}
  .metric-labels{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:1px;
    background:var(--line);
    border-top:1px solid var(--line);
  }
  .metric-cell{
    background:var(--tint);
    padding:1.6rem 1.2rem 1.8rem;
    text-align:center;
    display:flex;
    flex-direction:column-reverse;
    gap:.45rem;
  }
  .metric-cell dd{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(1.6rem,3vw,2.3rem);
    color:var(--pine);
    line-height:1;
  }
  .metric-cell dt{
    font-size:.78rem;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:var(--ink-soft);
    font-weight:500;
  }

  /* ---------- Repos & locations ---------- */
  .detail{
    background:var(--tint);
    padding:5rem 1.5rem 6rem;
  }
  .community{background:var(--sky);border-top:1px solid var(--line)}
  .community-inner{align-items:center}
  .community h2{
    font-family:var(--display);
    font-size:clamp(1.6rem,3.4vw,2.2rem);
    color:var(--pine);
    margin-bottom:.6rem;
  }
  .source-note{font-size:.85rem;color:var(--ink-soft);margin-top:1rem}
  .community-stats{margin:0}
  .community-stat{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:12px;
    padding:1.6rem;
    text-align:center;
    display:flex;
    flex-direction:column-reverse;
    gap:.4rem;
  }
  .community-stat dd{
    font-family:var(--display);
    font-weight:700;
    font-size:clamp(2.4rem,6vw,3.6rem);
    line-height:1;
    color:var(--pine);
  }
  .community-stat dt{
    font-size:.78rem;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--ink-soft);
    font-weight:500;
  }
  .community .badge-heading{
    font-family:var(--body);
    font-size:.78rem;
    letter-spacing:.12em;
    text-transform:uppercase;
    color:var(--ink-soft);
    font-weight:600;
    margin:1.6rem 0 .7rem;
  }
  .detail-inner{
    max-width:960px;
    margin:0 auto;
    display:grid;
    grid-template-columns:1.2fr .8fr;
    gap:4rem;
  }
  .detail h3{
    font-family:var(--display);
    font-weight:600;
    font-size:1.7rem;
    color:var(--pine);
    margin-bottom:.4rem;
  }
  .detail .sub{font-size:.92rem;color:var(--ink-soft);margin-bottom:1.6rem}
  .repo-list{list-style:none;margin:0;padding:0}
  .repo-list li{
    padding:.65rem 0;
    border-bottom:1px dashed var(--line);
    font-size:.95rem;
  }
  .repo-row{
    display:grid;
    grid-template-columns:2ch 1fr auto;
    gap:1rem;
    align-items:center;
  }
  .repo-list .rank{
    font-family:var(--display);
    font-weight:600;
    color:var(--pine-light);
  }
  .repo-list .bar-wrap{position:relative;padding-bottom:.55rem}
  .repo-list .name{font-weight:500}
  .repo-list .bar{
    position:absolute;
    left:0;bottom:0;
    height:5px;
    border-radius:3px;
    background:linear-gradient(90deg,var(--leaf-young),var(--pine-light));
    width:0;
  }
  html[data-motion="full"] .repo-list .bar{
    transition:width 1.1s cubic-bezier(.22,.9,.3,1);
  }
  .repo-list .count{
    font-variant-numeric:tabular-nums;
    color:var(--ink-soft);
    font-size:.88rem;
  }
  .loc-list{list-style:none;display:flex;flex-wrap:wrap;gap:.55rem}
  .loc-list li{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:99px;
    padding:.42rem .95rem;
    font-size:.88rem;
  }

  /* ---------- Footer ---------- */
  footer{
    background:var(--pine);
    color:var(--on-pine);
    text-align:center;
    padding:3.5rem 1.5rem;
  }
  footer a{color:inherit}
  footer .f-title{
    font-family:var(--display);
    font-size:1.5rem;
    font-weight:600;
  }
  footer p{opacity:.75;font-size:.9rem;margin-top:.6rem}

  @media (max-width:760px){
    html[data-motion="full"] .chapter{padding:0 5vw;align-items:flex-end;padding-bottom:12vh}
    html[data-motion="full"] .chapter.right{justify-content:flex-start}
    .panel{max-width:100%}
    .detail-inner{grid-template-columns:1fr;gap:3rem}
  }

  /* ---------- Accessibility: skip link, focus, tools ---------- */
  .skip-link{
    position:absolute;
    left:1rem;
    top:-5rem;
    z-index:1000;
    background:var(--pine);
    color:var(--on-pine);
    padding:.7rem 1.1rem;
    border-radius:0 0 10px 10px;
    font-weight:600;
    text-decoration:none;
    transition:top .15s ease;
  }
  html[data-motion="full"] .skip-link{transition:none}
  .skip-link:focus{top:0}
  :focus-visible{
    outline:3px solid var(--pine);
    outline-offset:3px;
    border-radius:3px;
  }
  [tabindex="-1"]:focus{outline:none}
  :target{scroll-margin-top:1.5rem}

  .visually-hidden{
    position:absolute!important;
    width:1px;height:1px;
    padding:0;margin:-1px;
    overflow:hidden;
    clip:rect(0 0 0 0);
    clip-path:inset(50%);
    white-space:nowrap;border:0;
  }

  /* Page tools appear only when JS can wire them up. */
  .page-tools{
    display:none;
    position:fixed;
    top:.6rem;
    right:.6rem;
    z-index:900;
    gap:.4rem;
    align-items:flex-start;
  }
  html.js .page-tools{display:flex}

  .tool{position:relative}
  .tool-btn{
    display:inline-flex;
    align-items:center;
    gap:.4rem;
    font:inherit;
    font-size:.82rem;
    line-height:1;
    padding:.45rem .7rem;
    min-height:2.75rem;
    color:var(--pine);
    background:var(--card);
    backdrop-filter:blur(6px);
    border:1px solid var(--line-strong);
    border-radius:99px;
    cursor:pointer;
  }
  .tool-btn:hover{background:var(--surface)}
  .tool-btn[aria-expanded="true"]{background:var(--surface);border-color:var(--pine)}
  .tool-icon{width:1.35rem;height:1.35rem;flex:none;fill:currentColor}
  .tool-chevron{width:.7rem;height:.7rem;flex:none;fill:currentColor;transition:transform .15s ease}
  .tool-btn[aria-expanded="true"] .tool-chevron{transform:rotate(180deg)}
  @media (prefers-reduced-motion:reduce){.tool-chevron{transition:none}}

  .tool-panel{
    position:absolute;
    top:calc(100% + .4rem);
    right:0;
    min-width:15rem;
    max-width:min(20rem, calc(100vw - 1.2rem));
    padding:1rem;
    text-align:left;
    background:var(--surface);
    border:1px solid var(--line-strong);
    border-radius:12px;
    box-shadow:0 10px 28px rgba(0,0,0,.18);
  }
  .tool-panel[hidden]{display:none}
  .tool-panel h2{
    font-family:var(--body);
    font-size:.95rem;
    font-weight:600;
    color:var(--ink);
    margin-bottom:.3rem;
  }
  .tool-hint{
    font-size:.78rem;
    color:var(--ink-soft);
    margin-bottom:.8rem;
  }
  .tool-field{display:flex;flex-direction:column;gap:.25rem;margin-bottom:.75rem}
  .tool-field:last-child{margin-bottom:0}
  .tool-field label{font-size:.82rem;font-weight:500;color:var(--ink)}
  .tool-field select{
    font:inherit;
    font-size:.85rem;
    padding:.45rem .6rem;
    border:1px solid var(--pine-light);
    border-radius:8px;
    background:var(--surface);
    color:var(--ink);
  }

  .chapter-nav ol{
    list-style:none;
    display:flex;
    flex-direction:column;
    gap:.25rem;
    margin:0;padding:0;
    font-size:.88rem;
  }
  .chapter-nav a{
    display:block;
    color:var(--pine);
    text-decoration:none;
    padding:.5rem .7rem;
    border:1px solid var(--line-strong);
    border-radius:8px;
  }
  .chapter-nav a:hover{background:var(--sky)}

  /* Metrics summary status / error region. */
  .metrics-status{
    max-width:640px;
    margin:0 auto 1.6rem;
    padding:.9rem 1.2rem;
    text-align:center;
    color:var(--ink-soft);
    font-size:.95rem;
  }
  .metrics-status[hidden]{display:none}
  .metrics-status.error{
    color:var(--error-fg);
    background:var(--error-bg);
    border:1px solid var(--error-line);
    border-radius:10px;
    font-weight:500;
  }

  /* ---------- User preference media queries ---------- */
  /* Without JS the theme cannot be resolved, so honour the OS setting directly. */
  @media (prefers-color-scheme:dark){
    html.no-js{
      --sky:#0F1713;--sky-deep:#16221B;--pine:#9FD3B0;--pine-light:#7FB894;
      --leaf:#7FB08A;--leaf-young:#B9DC9E;--bark:#C09070;--sun:#F0C46A;
      --blossom:#F0A3B4;--ink:#E7EFE9;--ink-soft:#B3C6B9;--surface:#1B2A22;
      --card:rgba(27,42,34,.86);--on-pine:#08120C;
      --line:rgba(159,211,176,.24);--line-strong:rgba(159,211,176,.42);
      --viz-1:#8FBF9E;--viz-2:#B3D89B;--viz-3:#7FB894;
      --viz-tree:#6E9478;--viz-ground:#5D8F5F;
      color-scheme:dark;
    }
  }
  @media (forced-colors:active){
    .panel,.metric-cell,.loc-list li,.chapter-nav a,.tool-btn,.tool-panel{
      background:Canvas;color:CanvasText;border-color:CanvasText;backdrop-filter:none;
    }
    .skip-link{background:Canvas;color:CanvasText;border:1px solid CanvasText}
    :focus-visible{outline:3px solid Highlight;outline-offset:3px}
    .repo-list .bar{background:CanvasText}
  }
  @media (prefers-contrast:more){
    :root{--ink-soft:#20302A;--card:var(--surface);--line:var(--pine);--line-strong:var(--pine)}
    html[data-theme="dark"]{--ink-soft:#DCE8E0}
    .panel,.metric-cell,.loc-list li{border-color:var(--pine);border-width:2px}
    .panel{box-shadow:none}
    .chapter-nav a,.tool-field select,.tool-btn{border-color:var(--pine)}
  }
  @media (prefers-reduced-transparency:reduce){
    :root{--card:var(--surface)}
    .panel,.stage-caption,.tool-btn{backdrop-filter:none;background:var(--surface)}
  }
</style>
<script>
/* Resolve the effective motion and colour preferences before first paint, so the
   static baseline is the default and there is no flash of motion or of the wrong
   theme. Without JS this never runs and the CSS falls back to the OS setting. */
(function(){
  var d = document.documentElement;
  d.classList.remove('no-js');
  d.classList.add('js');
  function stored(k){ try { return localStorage.getItem(k); } catch (e) { return null; } }
  function media(q){ try { return window.matchMedia(q).matches; } catch (e) { return false; } }

  var motion = stored('yir-motion');
  var full = motion === 'full' ? true
           : motion === 'reduce' ? false
           : !media('(prefers-reduced-motion: reduce)');
  d.setAttribute('data-motion', full ? 'full' : 'reduced');

  var theme = stored('yir-theme');
  var dark = theme === 'dark' ? true
           : theme === 'light' ? false
           : media('(prefers-color-scheme: dark)');
  d.setAttribute('data-theme', dark ? 'dark' : 'light');
})();
</script>
<script>window.YIR_DATA_FILE = {{ datafiles.github | dump | safe }};</script>
</head>
<body>

<a class="skip-link" href="#metrics">Skip animated story</a>

<!-- ============ HERO ============ -->
<header class="hero">
  <div class="page-tools">
    <div class="tool" data-tool>
